{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts", "build.mts", "worker.mts", "test/**/*.cts"]
}
